// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  USER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Category {
  id     String   @id @default(cuid())
  name   String   @unique @db.VarChar(50)
  ticket Ticket[] @relation("TicketCategory")
}

model Comments {
  id        String   @id @default(cuid())
  ticket_id String
  body      String   @db.VarChar(500)
  author_id String
  createdat DateTime @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)
  ticket    Ticket   @relation("Comments", fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author    Users    @relation("PostedComments", fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Status_history {
  id            String   @id @default(cuid())
  ticket_id     String
  status_from   String
  status_to     String   @db.VarChar(10)
  changed_by_id String
  changed_at    DateTime @db.Timestamp(6)
  changed_by    Users    @relation("ChangedStatuses", fields: [changed_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket        Ticket   @relation("StatusHistory", fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Tags {
  id          String        @id @default(cuid())
  name        String        @unique @db.VarChar(50)
  ticket_tags Ticket_tags[] @relation("Related_tickets")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Ticket {
  id            String         @id @default(cuid())
  category_id   String
  created_by_id String
  assigned_to_id String?
  title         String         @db.VarChar(500)
  description   String?        @db.VarChar(3000)
  priority      TicketPriority
  status        TicketStatus
  createdat     DateTime       @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)
  updatedat     DateTime       @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)

  comments       Comments[]       @relation("Comments")
  status_history Status_history[] @relation("StatusHistory")
  ticket_tags    Ticket_tags[]    @relation("TicketTags")

  category   Category @relation("TicketCategory", fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by Users    @relation("CreatedTickets", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assigned_to Users?    @relation("AssignedTickets", fields: [assigned_to_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([title], map: "ticket_title")
}

model Ticket_tags {
  ticket_id String
  tag_id    String
  tag       Tags   @relation("Related_tickets", fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket    Ticket @relation("TicketTags", fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([ticket_id, tag_id])
}

model Users {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  created_tickets        Ticket[]         @relation("CreatedTickets")
  assigned_tickets        Ticket[]         @relation("AssignedTickets")
  comments        Comments[]       @relation("PostedComments")
  status_history Status_history[] @relation("ChangedStatuses")

  @@index([name], map: "user_name")
}
