// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  USER
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Status_history {
  id            String   @id @default(cuid())
  issue_id      String
  status_from   String
  status_to     String   @db.VarChar(10)
  changed_by_id String
  changed_at    DateTime @db.Timestamp(6)

  changed_by    Users    @relation("ChangedStatuses", fields: [changed_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  issue         Issue    @relation("StatusHistory", fields: [issue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Issue {
  id             String        @id @default(cuid())
  created_by_id  String
  assigned_to_id String?
  project_id     String
  title          String        @db.VarChar(500)
  description    String?       @db.VarChar(3000)
  priority       IssuePriority
  status         IssueStatus   @default(OPEN)
  createdat      DateTime      @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)
  updatedat      DateTime      @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)

  status_history Status_history[] @relation("StatusHistory")

  project     Project @relation("Issues", fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by  Users  @relation("CreatedTickets", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assigned_to Users? @relation("AssignedTickets", fields: [assigned_to_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([title], map: "ticket_title")
}

model Project {
  id        String        @id @default(cuid())
  name      String        @unique @db.VarChar(500)
  
  issues    Issue[]  @relation("Issues")
}
model Users {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  created_issues  Issue[]          @relation("CreatedTickets")
  assigned_issues Issue[]          @relation("AssignedTickets")
  status_history  Status_history[] @relation("ChangedStatuses")

  @@index([name], map: "user_name")
}
